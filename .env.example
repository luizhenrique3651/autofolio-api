# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autofolio_dev
# URL JDBC: obrigatória em prod; em dev o padrão é jdbc:postgresql://localhost:5432/autofolio_dev
# DATABASE_URL=jdbc:postgresql://localhost:5432/autofolio_dev

# pgAdmin Credentials
PGADMIN_DEFAULT_EMAIL=admin@autofolio.com
PGADMIN_DEFAULT_PASSWORD=admin

# Security & CORS
FRONTEND_URL=http://localhost:5173
JWT_SECRET=sua_chave_secreta_aqui_com_pelo_menos_32_caracteres

# SMTP (e-mail de recuperação de senha). Em dev, os padrões abaixo apontam para um SMTP local (porta 1025)
MAIL_HOST=localhost
MAIL_PORT=1025   # só dev (SMTP local); em produção use 587
MAIL_USER=
MAIL_PASS=
# Remetente (From) dos e-mails; independe de MAIL_USER
MAIL_FROM=noreply@autofolio.com

# Cloudinary (upload de fotos) - obrigatório em todos os profiles
CLOUDINARY_CLOUD_NAME=seu_cloud_name
CLOUDINARY_API_KEY=sua_api_key
CLOUDINARY_API_SECRET=seu_api_secret
