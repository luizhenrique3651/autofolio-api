# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autofolio_dev

# pgAdmin Credentials
PGADMIN_DEFAULT_EMAIL=admin@autofolio.com
PGADMIN_DEFAULT_PASSWORD=admin

# Security & CORS
FRONTEND_URL=http://localhost:5173
JWT_SECRET=sua_chave_secreta_aqui_com_pelo_menos_32_caracteres

# SMTP (e-mail de recuperação de senha). Em dev, os padrões abaixo apontam para um SMTP local (porta 1025)
MAIL_HOST=localhost
MAIL_PORT=1025   # só dev (SMTP local); em produção use 587
MAIL_USER=
MAIL_PASS=
# Remetente (From) dos e-mails; independe de MAIL_USER
MAIL_FROM=noreply@autofolio.com
